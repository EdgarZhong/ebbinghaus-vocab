{
  "name": "ebbinghaus-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/protocol && tsc --noEmit -p packages/domain && tsc --noEmit -p server",
    "server:start": "pnpm --filter @ebbinghaus/server start",
    "server:backup": "pnpm --filter @ebbinghaus/server backup"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "typescript": "6.0.2",
    "vitest": "5.0.0"
  }
}
