{
  "name": "@ebbinghaus/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ebbinghaus V2 React 应用（浏览器模式一等公民）：应用外壳、设计令牌、Space 管理页与设置页",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
