{
  "name": "@ebbinghaus/app",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Ebbinghaus V2 React 与 Tauri 客户端：词书、常规学习及云端同步",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "vite build && playwright test",
    "e2e:native": "wdio run wdio.conf.ts",
    "android:medium-phone": "bash src-tauri/android-medium-phone.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-sql": "2.4.1",
    "liquid-glass-react": "1.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@ebbinghaus/application": "workspace:*",
    "@ebbinghaus/domain": "workspace:*",
    "@ebbinghaus/persistence": "workspace:*",
    "@ebbinghaus/protocol": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.4.0",
    "@wdio/tauri-service": "1.4.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
