    "typecheck": "tsc --noEmit -p .",
    "e2e": "vite build && playwright test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@ebbinghaus/application": "workspace:*",
    "@ebbinghaus/domain": "workspace:*",
    "@ebbinghaus/persistence": "workspace:*",
    "@ebbinghaus/protocol": "workspace:*",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
